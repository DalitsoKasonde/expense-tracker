# Host-specific deploy override. Copy to docker-compose.deploy.yml on the VM
# (that filename is gitignored) and adjust to the host's shared infrastructure:
#   - Traefik network 'edge'           -> the host's actual proxy network
#   - DB network      'chuma-database' -> the host's actual database network
#   - cert resolver   'letsencrypt'    -> the resolver name in traefik.yml
#   - Host rule       'yourdomain.com' -> the real domain
#
# Applied with: docker compose -f docker-compose.prod.yml -f docker-compose.deploy.yml ...
# deploy/vm/deploy.sh passes both files automatically.

services:
  api:
    labels:
      traefik.http.routers.chuma-api.rule: "Host(`expenses.example.com`) && PathPrefix(`/api`)"
      traefik.http.routers.chuma-api.tls.certresolver: "myresolver"
  web:
    labels:
      traefik.http.routers.chuma-web.rule: "Host(`expenses.example.com`)"
      traefik.http.routers.chuma-web.tls.certresolver: "myresolver"

networks:
  edge:
    external: true
    name: traefik-public
  database:
    external: true
    name: db-internal
