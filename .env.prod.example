# Copy to .env.prod on the VM and fill in real values. Never commit .env.prod.
#
# APP_VERSION is not set here: docker-compose.prod.yml derives it from the
# deployed IMAGE_TAG so /healthz reports the exact commit that is running.

# Shared PostgreSQL container on the private chuma-database Docker network.
# Port 5432 is not published by the VM.
DATABASE_URL=postgres://expenses_user:replace-with-a-url-safe-password@postgres:5432/expense_tracker?sslmode=disable
JWT_SECRET=
APP_ORIGIN=https://yourdomain.com
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# One-time operational administrator bootstrap. Remove both values after the
# first successful deployment; the administrator remains in the database.
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=
# Generate once with `openssl rand -base64 32` and retain a protected copy
# outside the server. BACKUP_DIR is set by docker-compose.prod.yml.
BACKUP_ENCRYPTION_KEY=

# Outgoing email (password resets, scheduled summaries, statements). Leave
# SMTP_HOST empty to disable sending; everything else keeps working and the API
# logs what it would have sent. SMTP_PASSWORD is the Resend API key, and
# MAIL_FROM_ADDRESS must sit on a domain verified with the provider.
# NOTE: many hosts (DigitalOcean included) block outbound 25, 465 and 587 to
# contain spam, and a blocked port times out rather than refusing — it looks
# like the relay is down. Resend publishes 2587 (STARTTLS) and 2465 (implicit
# TLS) for exactly this; production uses 2587.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=Inscribed Expenses
# Where replies land. MAIL_FROM_ADDRESS is a no-reply on a domain that need not
# host a mailbox, so without this a reply reaches nobody.
MAIL_REPLY_TO=
# Where links in emails point, so they must be publicly reachable.
APP_PUBLIC_URL=https://yourdomain.com
# Optional: receives a message whenever someone submits feedback.
ADMIN_ALERT_EMAIL=

# web
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=
# Google Cloud OAuth web client. Add this production redirect URI in Google:
# https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser requests use Traefik's same-origin /api route. This value is also
# the production Docker image's build-time default.
NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL=https://yourdomain.com/api
