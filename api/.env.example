DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/expense_tracker?sslmode=disable
JWT_SECRET=change-me
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me
# One-time operational administrator bootstrap. Remove after first startup.
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=
PORT=8080
MANSA_API_KEY=
BACKUP_DIR=./backups
# Base64-encoded 32-byte key, for example: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# Outgoing email. Leave SMTP_HOST empty to disable sending: the app keeps
# working and logs what it would have sent. Resend's relay is used here; Brevo,
# Mailgun and Gmail speak the same protocol, so only these values change.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
# Must be an address on a domain verified with the provider, or mail is rejected.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Chuma
# Where links in emails point. Emails are read outside the app, so this has to
# be the address a browser can reach.
APP_PUBLIC_URL=http://localhost:3000
# Optional: receives a message whenever someone submits feedback.
ADMIN_ALERT_EMAIL=
# Where replies land. MAIL_FROM_ADDRESS is a no-reply on a domain that need not
# host a mailbox, so without this a reply reaches nobody.
MAIL_REPLY_TO=
